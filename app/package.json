{
  "name": "freel",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Poste de pilotage d'un indépendant en micro-BNC",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verifier:responsive": "node scripts/verifier-responsive.mjs",
    "verifier:responsive:captures": "node scripts/verifier-responsive.mjs --captures",
    "verifier": "npm run typecheck && npm test && npm run build && npm run verifier:cablage && npm run verifier:budget && npm run verifier:responsive && npm run verifier:index && npm run verifier:confidentialite && npm run verifier:migration && npm run verifier:vitesse && npm run verifier:octets-nuls && npm run verifier:tutoiement && npm run verifier:contraste && npm run verifier:code-mort && npm run verifier:hooks && npm run verifier:bascule && npm run verifier:fuites",
    "verifier:vitesse": "node scripts/verifier-vitesse.mjs",
    "verifier:index": "node scripts/verifier-index-perime.mjs",
    "verifier:fuites": "node ../tests/smoke-test.js",
    "verifier:budget": "node scripts/verifier-budget.mjs",
    "verifier:cablage": "node scripts/verifier-cablage.mjs",
    "verifier:migration": "node scripts/verifier-migration-bout-en-bout.mjs",
    "verifier:confidentialite": "node scripts/verifier-confidentialite.mjs",
    "verifier:hooks": "eslint src",
    "verifier:octets-nuls": "node scripts/verifier-octets-nuls.mjs",
    "verifier:tutoiement": "node scripts/verifier-tutoiement.mjs",
    "verifier:contraste": "node scripts/verifier-contraste.mjs",
    "verifier:code-mort": "node scripts/verifier-code-mort.mjs",
    "verifier:bascule": "node scripts/verifier-bascule.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.0.0",
    "playwright": "^1.62.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.0.0",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  }
}
